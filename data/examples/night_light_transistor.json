{
  "schema_version": "0.2.0",
  "project_id": "night-light-bjt",
  "name": "Automatic Night Light (transistor)",
  "description": "LDR/resistor divider biases an NPN switch that lights an LED in the dark. No microcontroller.",
  "curriculum_context": {
    "module": "Analog Fundamentals",
    "concept": "Transistor as a switch",
    "competency_level": "BEGINNER"
  },
  "components": [
    {
      "instance_id": "bt1",
      "component_type": "power:battery-9v",
      "parameters": {},
      "metadata": {
        "role": "supply"
      }
    },
    {
      "instance_id": "r1",
      "component_type": "passive:resistor-tht",
      "parameters": {
        "resistance": "10k"
      },
      "metadata": {
        "role": "divider top"
      }
    },
    {
      "instance_id": "ldr1",
      "component_type": "sensor:photoresistor",
      "parameters": {},
      "metadata": {
        "role": "light sensor (divider bottom)"
      }
    },
    {
      "instance_id": "r2",
      "component_type": "passive:resistor-tht",
      "parameters": {
        "resistance": "4.7k"
      },
      "metadata": {
        "role": "base resistor"
      }
    },
    {
      "instance_id": "q1",
      "component_type": "semiconductor:npn-bc547",
      "parameters": {},
      "metadata": {
        "role": "low-side LED switch"
      }
    },
    {
      "instance_id": "r3",
      "component_type": "passive:resistor-tht",
      "parameters": {
        "resistance": "470"
      },
      "metadata": {
        "role": "LED current limit"
      }
    },
    {
      "instance_id": "d1",
      "component_type": "passive:led-5mm",
      "parameters": {
        "color": "white"
      },
      "metadata": {
        "role": "night light"
      }
    }
  ],
  "nets": [
