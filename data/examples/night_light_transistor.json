      "net_id": "vbat",
      "connections": [
        {
          "instance_id": "bt1",
          "pin_id": "POS"
        },
        {
          "instance_id": "r1",
          "pin_id": "PIN1"
        },
        {
          "instance_id": "r3",
          "pin_id": "PIN1"
        }
      ],
      "net_type": "power"
    },
    {
      "net_id": "gnd",
      "connections": [
        {
          "instance_id": "bt1",
          "pin_id": "NEG"
        },
        {
          "instance_id": "ldr1",
          "pin_id": "PIN2"
        },
        {
          "instance_id": "q1",
          "pin_id": "E"
        }
      ],
      "net_type": "ground"
    },
    {
      "net_id": "sense",
      "connections": [
        {
          "instance_id": "r1",
          "pin_id": "PIN2"
        },
        {
          "instance_id": "ldr1",
          "pin_id": "PIN1"
        },
        {
          "instance_id": "r2",
          "pin_id": "PIN1"
        }
      ],
      "net_type": "signal"
    },
    {
      "net_id": "base",
      "connections": [
        {
          "instance_id": "r2",
          "pin_id": "PIN2"
        },
        {
          "instance_id": "q1",
          "pin_id": "B"
        }
